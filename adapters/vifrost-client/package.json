{
  "name": "@vifrost/client",
  "version": "0.5.0",
  "description": "Framework-agnostic runtime client for Laravel Vifrost APIs: a typed Model base class, a spatie/laravel-query-builder-compatible query builder, and an identity map ready for real-time sync.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asdfprah/vifrost.git",
    "directory": "adapters/vifrost-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "laravel",
    "vifrost",
    "rest",
    "api-client"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  }
}
